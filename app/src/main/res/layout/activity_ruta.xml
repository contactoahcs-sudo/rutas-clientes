<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="?attr/actionBarSize"
        android:background="#1F2329" app:titleTextColor="#FFFFFF"
        app:navigationIcon="@drawable/ic_atras" />

    <FrameLayout android:id="@+id/contenedorMapa"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mapa"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <TextView android:id="@+id/ayudaMapa"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="top" android:background="#CC000000" android:padding="10dp"
            android:gravity="center" android:textColor="#FFFFFF" android:visibility="gone"
            android:text="Toca el mapa donde está el cliente (o mantén presionado en cualquier momento)" />
    </FrameLayout>

    <TextView android:id="@+id/conteo"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#2B3038" android:paddingHorizontal="14dp" android:paddingVertical="8dp"
        android:textColor="#FFFFFF" android:textSize="14sp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/lista"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.1" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="#1F2329" android:gravity="center_vertical" android:orientation="horizontal"
        android:padding="8dp">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/optimizar"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="OPTIMIZAR" app:backgroundTint="#F28C28" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/siguiente"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginHorizontal="8dp" android:text="Ir a la siguiente"
            android:textColor="#FFFFFF" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/agregar"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="+" android:textSize="22sp" app:backgroundTint="#43A047" />
    </LinearLayout>
</LinearLayout>
